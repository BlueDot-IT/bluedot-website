DATABASE_URL="mysql://user:password@localhost:3306/bluedot"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Admin access fails closed unless the signed-in email appears here.
ADMIN_EMAIL="admin@example.com"
ADMIN_EMAILS="admin@example.com,security@example.com"
ADMIN_USER="admin"
ADMIN_PASS="replace-with-a-strong-password"

# Public account creation is disabled by default.
ALLOW_PUBLIC_REGISTRATION="false"

# Set only when the named header is overwritten by a trusted reverse proxy.
# For the documented Nginx/Vercel deployments, x-forwarded-for is appropriate
# only after confirming clients cannot choose the right-most value.
RATE_LIMIT_IP_HEADER="x-forwarded-for"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="BlueDot IT <noreply@example.com>"
