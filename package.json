    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.6.2",
    "@types/nodemailer": "7.0.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.10",
    "daisyui": "^5.5.14",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.0",
    "postcss": "8.5.25",
