    "yaml": "2.9.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@next/third-parties": "^16.0.7",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "^4.3.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.21",
    "next-auth": "4.24.15",
    "next-mdx-remote": "6.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "7.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-to-print": "^3.1.1",
